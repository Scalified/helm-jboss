{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "JBoss Helm Chart Values Schema",
  "description": "Schema for values.yaml for JBoss Helm Chart",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string",
      "description": "Override the name of the chart (used in naming resources)",
      "default": ""
    },
    "fullnameOverride": {
      "type": "string",
      "description": "Override the full name (default is the chart name + release name)",
      "default": ""
    },
    "jboss": {
      "type": "object",
      "description": "JBoss Enterprise Application Platform (EAP) configuration for Kubernetes deployment",
      "properties": {
        "annotations": {
          "type": "object",
          "description": "Metadata annotations for the JBoss deployment",
          "default": {}
        },
        "replicaCount": {
          "type": "integer",
          "description": "Number of replicas/pods to run (should typically be 1 for JBoss EAP)",
          "minimum": 1,
          "default": 1
        },
        "containers": {
          "type": "object",
          "description": "JBoss containers configuration",
          "properties": {
            "jboss": {
              "type": "object",
              "properties": {
                "image": {
                  "type": "object",
                  "properties": {
                    "repository": {
                      "type": "string",
                      "description": "Docker image repository for JBoss",
                      "default": "scalified/jboss-eap"
                    },
                    "tag": {
                      "type": "string",
                      "description": "Image tag to use (leave empty to use default from Chart or latest)",
                      "default": ""
                    },
                    "pullPolicy": {
                      "type": "string",
                      "description": "Image pull policy (e.g., Always, IfNotPresent, Never)",
                      "enum": [
                        "Always",
                        "IfNotPresent",
                        "Never"
                      ],
                      "default": "IfNotPresent"
                    }
                  },
                  "required": [
                    "repository",
                    "pullPolicy"
                  ]
                },
                "env": {
                  "type": "array",
                  "description": "Environment variables for JBoss container",
                  "default": [],
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "value"
                    ]
                  }
                },
                "livenessProbe": {
                  "type": "object",
                  "description": "Liveness probe configuration for the JBoss container"
                },
                "readinessProbe": {
                  "type": "object",
                  "description": "Readiness probe configuration for the JBoss container"
                },
                "resources": {
                  "type": "object",
                  "properties": {
                    "requests": {
                      "type": "object",
                      "properties": {
                        "memory": {
                          "type": "string",
                          "description": "Minimum amount of memory requested for the container",
                          "default": "1Gi"
                        }
                      }
                    }
                  }
                },
                "volumeMounts": {
                  "type": "array",
                  "description": "Additional volume mounts for the JBoss container",
                  "default": [],
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "mountPath": {
                        "type": "string"
                      },
                      "subPath": {
                        "type": "string"
                      }
                    }
                  }
                },
                "ports": {
                  "type": "array",
                  "description": "List of ports to expose from the JBoss container",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "containerPort": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      },
                      "protocol": {
                        "type": "string",
                        "enum": [
                          "TCP",
                          "UDP",
                          "SCTP"
                        ]
                      }
                    },
                    "required": [
                      "name",
                      "containerPort",
                      "protocol"
                    ]
                  }
                }
              },
              "required": [
                "image",
                "ports"
              ]
            }
          },
          "required": [
            "jboss"
          ]
        },
        "hostname": {
          "type": "string",
          "description": "Hostname used for the JBoss pod/container",
          "default": ""
        },
        "imagePullSecrets": {
          "type": "array",
          "description": "Image pull secrets for the JBoss container",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the image pull secret"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "volumes": {
          "type": "array",
          "description": "Additional volumes to be mounted into the pod",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "persistentVolumeClaim": {
                "type": "object",
                "properties": {
                  "claimName": {
                    "type": "string"
                  }
                },
                "required": [
                  "claimName"
                ]
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "services": {
          "type": "array",
          "description": "Configuration for the Kubernetes Services exposing JBoss",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Kubernetes service type (e.g., ClusterIP, NodePort, LoadBalancer)",
                "enum": [
                  "ClusterIP",
                  "NodePort",
                  "LoadBalancer",
                  "ExternalName"
                ],
                "default": "ClusterIP"
              },
              "ports": {
                "type": "array",
                "description": "List of ports to expose via the service",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "targetPort": {
                      "type": ["integer"],
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "protocol": {
                      "type": "string",
                      "enum": [
                        "TCP",
                        "UDP",
                        "SCTP"
                      ],
                      "default": "TCP"
                    }
                  },
                  "required": [
                    "name",
                    "port",
                    "targetPort",
                    "protocol"
                  ]
                }
              }
            },
            "required": [
              "type",
              "ports"
            ]
          }
        },
        "ingress": {
          "type": "object",
          "description": "Configuration for Ingress to expose JBoss via HTTP/HTTPS",
          "default": {}
        }
      },
      "required": [
        "containers"
      ]
    }
  },
  "required": [
    "jboss"
  ]
}
